# ── Peppa Memory Game — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git!

# Secret key used to sign the leaderboard file (HMAC integrity check).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
PEPPA_SECRET_KEY=change-me-to-a-random-secret

# Max leaderboard saves per session (rate limiting)
PEPPA_RATE_LIMIT=3

# Max scores stored in leaderboard
PEPPA_MAX_SCORES=50

# Path to scores file (default: peppa_scores.json next to app.py)
PEPPA_SCORES_FILE=peppa_scores.json
